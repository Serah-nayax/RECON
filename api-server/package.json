{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=../.env.local --use-system-ca --max-old-space-size=2048 --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@crawlee/memory-storage": "^3.18.1",
    "@crawlee/playwright": "^3.18.1",
    "@huggingface/transformers": "^4.3.2",
    "@opentelemetry/api": "^1.10.0",
    "@workspace/db": "workspace:*",
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "p-retry": "^7.1.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "playwright": "^1.61.1",
    "undici": "^7.30.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
